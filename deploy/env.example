ROLL_DATA=/srv/roll
ROLL_DIST=/opt/roll/dist
ROLL_PORT=8080
ROLL_ORIGIN=https://roll.zyx.tw
# Renders at once. Each one runs vips or ffmpeg.
ROLL_WORKERS=2
# GiB an upload must leave free on the disk.
ROLL_RESERVE_GB=10
OTEL_EXPORTER_OTLP_ENDPOINT=https://sensorium.zyx.tw
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>
OTEL_SERVICE_NAME=roll
# Accept App Attest from Xcode debug builds too (TestFlight uses production).
# ROLL_APPATTEST_DEVELOPMENT=1
